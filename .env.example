# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Long random string, 32+ characters. Signs the login cookie.
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
# Hours after the arrest within which it must be logged. PLACEHOLDER: confirm the real rule.
LATE_LOG_HOURS=2
